Thumbs.db

# Phase 3 (CoastSat): vendored third-party repo, and downloaded satellite
# imagery -- both can be multiple GB, well over GitHub's 100MB file limit,
# and are both fully reproducible (re-clone / re-download) rather than
# something to version control.
external/
coastsat_data/

# Phase 4: the single-file bundles are ~4MB each and are pure duplication of
# site/ -- regenerate with `python scripts/bundle_site.py`. site/ itself IS
# committed, so GitHub Pages can serve it without running any build.
dist/

# Local assistant/session state, not project code.
.claude/
